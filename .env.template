# GLCS Environment Variables Template
# Copy this file to .env and fill in your API keys

# =============================================================================
# PROVIDER API KEYS
# =============================================================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AI...

# Groq API Key
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# =============================================================================
# OLLAMA CONFIGURATION (Local - No API key needed!)
# =============================================================================

# Ollama runs locally - no API key required
# Just install Ollama from: https://ollama.ai
# Default endpoint (only change if using custom setup)
# OLLAMA_ENDPOINT=http://localhost:11434

# =============================================================================
# GLCS CONFIGURATION
# =============================================================================

# Default provider to use if not specified
# Options: openai, anthropic, gemini, groq, ollama
GLCS_DEFAULT_PROVIDER=openai

# Memory persistence file path
GLCS_MEMORY_PATH=glcs_memory.json

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
GLCS_LOG_LEVEL=INFO

# Log file path (optional)
GLCS_LOG_FILE=glcs.log

# =============================================================================
# PROVIDER SELECTION GUIDE
# =============================================================================

# For Testing/Development:
#   - Use Ollama with llama3.2 (FREE, fast, good enough, 100% private)
#   - GLCS_DEFAULT_PROVIDER=ollama

# For Production:
#   - Use GPT-4o-mini (best price/performance, $0.06 per 1000 parses)
#   - GLCS_DEFAULT_PROVIDER=openai
#
#   - Or Gemini 1.5 Flash (cheapest, $0.04 per 1000 parses, great quality)
#   - GLCS_DEFAULT_PROVIDER=gemini

# For Privacy-Critical Applications:
#   - Use Ollama with mistral or qwen2.5 (100% local, excellent quality)
#   - GLCS_DEFAULT_PROVIDER=ollama

# For Ultra-Fast Inference:
#   - Use Groq with mixtral (fastest inference available)
#   - GLCS_DEFAULT_PROVIDER=groq

# For Best Quality:
#   - Use GPT-4o or Claude 3.5 Sonnet (highest quality)
#   - GLCS_DEFAULT_PROVIDER=openai or anthropic

# =============================================================================
# OPTIONAL: Override specific provider settings
# =============================================================================

# Override default model for a provider
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-opus-20240229
# GEMINI_MODEL=gemini-1.5-pro
# GROQ_MODEL=llama-3.1-70b-versatile
# OLLAMA_MODEL=mistral

# Override temperature (0.0 = deterministic, 1.0 = creative)
# GLCS_TEMPERATURE=0.7

# Override max tokens per response
# GLCS_MAX_TOKENS=150
